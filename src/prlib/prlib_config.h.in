#define PROLOGD_VERSION "${PROLOGD_VERSION}"
#define PROLOGD_RELEASE_DATE "${PROLOGD_RELEASE_DATE}"

//: What the version predicate prints (`?ВЕРСИЯ`, hpversion in extfunc.cpp): the
//: release stamp of the dialect alone.  It is deliberately not the date of the
//: build - a stamp that moved with every configure would make the answer depend
//: on when the binary happened to be built.
#define PROLOGD_VERSION_STRING PROLOGD_RELEASE_DATE
